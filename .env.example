# Default: gunakan login ChatGPT dari Codex CLI. Pada Vercel gunakan access token
# workspace ChatGPT Business/Enterprise; jangan pernah commit nilai token ini.
AI_PROVIDER=codex
CODEX_ACCESS_TOKEN=
# Login ChatGPT Business melalui UI (opsi sementara untuk Vercel). Hubungkan
# Private Vercel Blob. Store baru memakai OIDC dan menambahkan BLOB_STORE_ID;
# store lama dapat memakai BLOB_READ_WRITE_TOKEN.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CODEX_AUTH_ENCRYPTION_KEY=
# Secret panjang yang hanya diketahui admin aplikasi untuk membuka alur login.
CODEX_LOGIN_ADMIN_SECRET=
# Opsional untuk server non-Vercel. Di Vercel wajib dikosongkan agar binary
# Linux dari dependency @openai/codex dipilih otomatis.
CODEX_CLI_PATH=
# Model default asisten data; dapat diganti melalui environment server.
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=low
CODEX_TURN_TIMEOUT_MS=120000
# Codex CLI Linux melebihi bundle fungsi standar. Aktifkan Large Functions pada
# project Vercel lama; project baru yang memenuhi syarat dapat aktif otomatis.
VERCEL_SUPPORT_LARGE_FUNCTIONS=1

# Untuk kembali ke provider API, ubah AI_PROVIDER menjadi groq, openrouter, 9router, atau custom.
# Seluruh key, base URL, dan model hanya dibaca dari environment server.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Opsional. Tanpa key ini chatbot tetap dapat mencari langsung di website resmi
# Rumah Zakat. Jika diisi, pencarian dapat diperluas ke domain institusional
# tepercaya untuk topik pemberdayaan, zakat, CSR, SDGs, ESG, dan dampak sosial.
BRAVE_SEARCH_API_KEY=

# Authentication and access approval (Firebase)
# Nilai NEXT_PUBLIC_* tersedia di Firebase Console > Project settings > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Buat service account melalui Firebase Console > Project settings > Service accounts.
# Simpan private key di Vercel sebagai satu baris dengan karakter \\n+FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
AUTH_ADMIN_EMAILS=hari.pamungkas@rumahzakat.org,candra.juari@rumahzakat.org,pd.rumahzakat@gmail.com

# 9Router dan provider custom harus menyediakan endpoint OpenAI-compatible.
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=
NINEROUTER_MODEL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bot Telegram publik. Buat token melalui @BotFather dan gunakan URL deployment HTTPS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PUBLIC_URL=
